    "tests": {
      "title": "Agent-generated native behavior tests",
      "lines": [
        "import unittest",
        "",
        "from main import main",
        "",
        "",
        "class GreetingCardBehaviorTests(unittest.TestCase):",
        "    def test_example_grace_hopper(self):",
        "        arguments = [{\"name\": \"Grace Hopper\", \"messages\": [\"Compiler pioneer\", \"COBOL ",
        "leader\"]}]",
        "        expected = {\"greeting\": \"Hello, Grace Hopper!\", \"recipient_id\": \"grace-hopper\", ",
        "\"message_count\": 2, \"word_count\": 4}",
        "        self.assertEqual(main(*arguments), expected)",
        "",
        "    def test_boundary_empty_card(self):",
        "        arguments = [{\"name\": \"\", \"messages\": []}]",
        "        expected = {\"greeting\": \"Hello, !\", \"recipient_id\": \"\", \"message_count\": 0, ",
        "\"word_count\": 0}",
        "        self.assertEqual(main(*arguments), expected)",
        "",
        "    def test_invariant_unicode_separators(self):",
        "        arguments = [{\"name\": \"  \u00c9lodie__O'Connor  \", \"messages\": [\"alpha\\tbeta\\n gamma\", \"\", ",
        "\"delta\\u2003epsilon\"]}]",
        "        expected = {\"greeting\": \"Hello,   \u00c9lodie__O'Connor  !\", \"recipient_id\": \"\u00e9lodie-o-",
        "connor\", \"message_count\": 3, \"word_count\": 5}",
        "        self.assertEqual(main(*arguments), expected)",
        "",
        "    def test_invariant_unicode_alphanumeric(self):",
        "        arguments = [{\"name\": \"Version \uff12!\", \"messages\": [\"one\\u00a0two\"]}]"
      ],
