{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:literate-ai:schema:v1:source-to-specification-contracts",
  "oneOf": [
    { "$ref": "urn:literate-ai:schema:v1:spec-authoring-skill" }, { "$ref": "urn:literate-ai:schema:v1:spec-authoring-skill-set" },
    { "$ref": "urn:literate-ai:schema:v1:source-to-specification-request" }, { "$ref": "urn:literate-ai:schema:v1:behavior-observation" },
    { "$ref": "urn:literate-ai:schema:v1:specification-draft-set" }, { "$ref": "urn:literate-ai:schema:v1:source-specification-coverage-map" },
    { "$ref": "urn:literate-ai:schema:v1:uncertainty-ledger" }, { "$ref": "urn:literate-ai:schema:v1:source-to-specification-result" }
  ],
  "$defs": {
    "skillRef": { "type": "object", "additionalProperties": false, "required": ["skill_id", "version", "content_digest"], "properties": { "skill_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "version": { "$ref": "urn:literate-ai:schema:v1:identity-contracts#/$defs/semver" }, "content_digest": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" } } },
    "skill": {
      "$id": "urn:literate-ai:schema:v1:spec-authoring-skill", "type": "object", "additionalProperties": false,
      "required": ["skill_id", "version", "content_digest", "title", "capabilities", "facets", "evidence_kinds", "model_capabilities", "dependencies", "after", "limitations", "trust_classification", "prompt_template", "extensions", "dependency_refs"],
      "properties": { "skill_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "version": { "$ref": "urn:literate-ai:schema:v1:identity-contracts#/$defs/semver" }, "content_digest": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "title": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "capabilities": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/nonemptyStringArray" }, "facets": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/nonemptyStringArray" }, "evidence_kinds": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/nonemptyStringArray" }, "model_capabilities": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "dependencies": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "after": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "limitations": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "trust_classification": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "prompt_template": { "type": "string" }, "extensions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }, "dependency_refs": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/skillRef" } } }
    },
    "skillSet": { "$id": "urn:literate-ai:schema:v1:spec-authoring-skill-set", "type": "object", "additionalProperties": false, "required": ["skill_set_id", "version", "skills", "conflict_policy"], "properties": { "skill_set_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "version": { "$ref": "urn:literate-ai:schema:v1:identity-contracts#/$defs/semver" }, "skills": { "type": "array", "minItems": 1, "items": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/skillRef" } }, "conflict_policy": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" } } },
    "request": {
      "$id": "urn:literate-ai:schema:v1:source-to-specification-request", "type": "object", "additionalProperties": false,
      "required": ["request_id", "source_snapshot_id", "source_content_digest", "origin_attestation_id", "mode", "output_provider", "skill_set_id", "routing_policy_id", "redaction_policy_id", "egress_policy_id", "included_paths", "excluded_paths", "facets", "previous_specification_set_id"],
      "properties": { "request_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "source_snapshot_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "source_content_digest": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "origin_attestation_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "mode": { "enum": ["bootstrap", "audit", "refresh", "conformance"] }, "output_provider": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "skill_set_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "routing_policy_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "redaction_policy_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "egress_policy_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "included_paths": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "excluded_paths": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "facets": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "previous_specification_set_id": { "type": ["string", "null"] } }
    },
    "evidenceReference": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "source_snapshot_id", "content_digest", "path", "symbol"], "properties": { "evidence_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "source_snapshot_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "content_digest": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "path": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "symbol": { "type": "string" } } },
    "observation": {
      "$id": "urn:literate-ai:schema:v1:behavior-observation", "type": "object", "additionalProperties": false,
      "required": ["observation_id", "surface_ids", "facet", "claim_kind", "statement", "evidence", "skill", "confidence", "model_call_id"],
      "properties": { "observation_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "surface_ids": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/nonemptyStringArray" }, "facet": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "claim_kind": { "enum": ["observed-current-behavior", "inferred-intent", "suspected-defect", "compatibility-quirk", "conflict", "unknown"] }, "statement": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "evidence": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/evidenceReference" } }, "skill": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/skillRef" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "model_call_id": { "type": ["string", "null"] } }
    },
    "draftScenario": { "type": "object", "additionalProperties": false, "required": ["name", "when", "then"], "properties": { "name": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "when": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "then": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" } } },
    "draftStatement": { "type": "object", "additionalProperties": false, "required": ["statement_id", "capability", "requirement", "scenarios", "observation_ids"], "properties": { "statement_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "capability": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "requirement": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/draftScenario" } }, "observation_ids": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/nonemptyStringArray" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "content"], "properties": { "path": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "content": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" } } },
    "providerValidation": { "type": "object", "additionalProperties": false, "required": ["provider", "provider_version", "valid", "diagnostics"], "properties": { "provider": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "provider_version": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "valid": { "type": "boolean" }, "diagnostics": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" } } },
    "draft": {
      "$id": "urn:literate-ai:schema:v1:specification-draft-set", "type": "object", "additionalProperties": false,
      "required": ["draft_id", "request_id", "source_snapshot_id", "output_provider", "skill_set_identity", "statements", "artifacts", "validation"],
      "properties": { "draft_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "request_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "source_snapshot_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "output_provider": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "skill_set_identity": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "statements": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/draftStatement" } }, "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/artifact" } }, "validation": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/providerValidation" } }
    },
    "coverageEntry": { "type": "object", "additionalProperties": false, "required": ["surface_id", "state", "observation_ids", "statement_ids", "reason"], "properties": { "surface_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "state": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/coverageState" }, "observation_ids": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "statement_ids": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "reason": { "type": "string" } } },
    "coverage": { "$id": "urn:literate-ai:schema:v1:source-specification-coverage-map", "type": "object", "additionalProperties": false, "required": ["request_id", "entries"], "properties": { "request_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "entries": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/coverageEntry" } } } },
    "uncertaintyItem": { "type": "object", "additionalProperties": false, "required": ["uncertainty_id", "kind", "message", "observation_ids", "surface_ids", "blocking"], "properties": { "uncertainty_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "kind": { "enum": ["ambiguity", "conflict", "suspected-defect", "missing-evidence", "skill-disagreement", "unknown"] }, "message": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "observation_ids": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "surface_ids": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "blocking": { "type": "boolean" } } },
    "uncertainty": { "$id": "urn:literate-ai:schema:v1:uncertainty-ledger", "type": "object", "additionalProperties": false, "required": ["request_id", "items"], "properties": { "request_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "items": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/uncertaintyItem" } } } },
    "run": { "type": "object", "additionalProperties": false, "required": ["run_id", "request_identity", "skill_set_identity", "observation_ids", "draft_identity"], "properties": { "run_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "request_identity": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "skill_set_identity": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "observation_ids": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "draft_identity": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" } } },
    "componentDraft": { "type": "object", "additionalProperties": false, "required": ["coordinate", "title", "provided_capabilities", "source_snapshot_id"], "properties": { "coordinate": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "title": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" }, "provided_capabilities": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/stringArray" }, "source_snapshot_id": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/text" } } },
    "result": {
      "$id": "urn:literate-ai:schema:v1:source-to-specification-result", "type": "object", "additionalProperties": false,
      "required": ["request", "observations", "draft", "coverage", "uncertainty", "run", "component_definition_draft"],
      "properties": { "request": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-request" }, "observations": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:behavior-observation" } }, "draft": { "$ref": "urn:literate-ai:schema:v1:specification-draft-set" }, "coverage": { "$ref": "urn:literate-ai:schema:v1:source-specification-coverage-map" }, "uncertainty": { "$ref": "urn:literate-ai:schema:v1:uncertainty-ledger" }, "run": { "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/run" }, "component_definition_draft": { "oneOf": [{ "$ref": "urn:literate-ai:schema:v1:source-to-specification-contracts#/$defs/componentDraft" }, { "type": "null" }] } }
    },
    "text": { "type": "string", "minLength": 1 }, "stringArray": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "nonemptyStringArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "coverageState": { "enum": ["covered", "intentionally-excluded", "implementation-detail", "unresolved", "conflicting", "unsupported"] }
  }
}
