{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v1:specification-set",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "provider_kind", "provider_version", "artifacts", "requirements", "baseline_id", "active_change_id"],
  "properties": {
    "schema": { "const": "urn:literate-ai:schema:v1:specification-set" },
    "provider_kind": { "type": "string", "minLength": 1 },
    "provider_version": { "type": "string", "minLength": 1 },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
    "baseline_id": { "type": ["string", "null"], "minLength": 1 },
    "active_change_id": { "type": ["string", "null"], "minLength": 1 }
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "identity"],
      "properties": { "uri": { "type": "string", "minLength": 1 }, "identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" } }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "title", "given", "when", "then"],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "given": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "when": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "then": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "title", "statement", "scenarios"],
      "properties": {
        "requirement_id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
      }
    }
  }
}
