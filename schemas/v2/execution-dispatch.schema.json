{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:execution-dispatch-contracts",
  "oneOf": [
    {"$ref": "urn:literate-ai:schema:v1:gpu-requirement"},
    {"$ref": "urn:literate-ai:schema:v1:execution-requirements"},
    {"$ref": "urn:literate-ai:schema:v1:execution-worker-parameter"},
    {"$ref": "urn:literate-ai:schema:v1:execution-worker-parameter-value"},
    {"$ref": "urn:literate-ai:schema:v1:execution-worker-environment"},
    {"$ref": "urn:literate-ai:schema:v1:execution-worker"},
    {"$ref": "urn:literate-ai:schema:v1:execution-worker-catalog"},
    {"$ref": "urn:literate-ai:schema:v1:observed-gpu-device"},
    {"$ref": "urn:literate-ai:schema:v1:worker-hardware-observation"},
    {"$ref": "urn:literate-ai:schema:v1:worker-hardware-observation-catalog"},
    {"$ref": "urn:literate-ai:schema:v2:execution-source-materialization"},
    {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-request"},
    {"$ref": "urn:literate-ai:schema:v2:observed-execution-environment"},
    {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-result"},
    {"$ref": "urn:literate-ai:schema:v1:remote-evidence-file"},
    {"$ref": "urn:literate-ai:schema:v1:remote-failure-diagnostic"},
    {"$ref": "urn:literate-ai:schema:v1:remote-lifecycle-evidence-manifest"},
    {"$ref": "urn:literate-ai:schema:v1:remote-execution-control-result"},
    {"$ref": "urn:literate-ai:schema:v1:remote-evidence-custody-receipt"}
  ],
  "$defs": {
    "library_product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifact_export", "import_surface"],
      "properties": {
        "schema": {"const": "literate-ai/library-rebuild-artifact@1"},
        "artifact_export": {"allOf": [
          {"$ref": "urn:literate-ai:schema:v2:artifact-export"},
          {"properties": {"role": {"const": "library"}}}
        ]},
        "import_surface": {"$ref": "urn:literate-ai:schema:v2:library-import-surface@1"},
        "native_layout": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/cpp_library_layout"}
      },
      "if": {"properties": {"import_surface": {"properties": {"language": {"const": "cpp"}}, "required": ["language"]}}},
      "then": {"required": ["native_layout"]},
      "else": {"not": {"required": ["native_layout"]}}
    },
    "cpp_library_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "headers", "link_files", "runtime_files"],
      "properties": {
        "schema": {"const": "literate-ai/cpp-library-layout@1"},
        "kind": {"enum": ["static", "shared"]},
        "headers": {"type": "array", "minItems": 1, "maxItems": 16384, "uniqueItems": true, "items": {"type": "string", "maxLength": 512, "pattern": "^include/.+"}},
        "link_files": {"type": "array", "minItems": 1, "maxItems": 16384, "uniqueItems": true, "items": {"type": "string", "maxLength": 512, "pattern": "^lib/.+"}},
        "runtime_files": {"type": "array", "maxItems": 16384, "uniqueItems": true, "items": {"type": "string", "maxLength": 512, "pattern": "^(lib|bin)/.+"}}
      },
      "if": {"properties": {"kind": {"const": "static"}}},
      "then": {"properties": {"runtime_files": {"maxItems": 0}}},
      "else": {"properties": {"runtime_files": {"minItems": 1}}}
    },
    "portable_value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]*$"
    },
    "portable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "portable_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "coverage_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_path", "reason", "detail", "gate"],
      "properties": {
        "file_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "reason": {
          "enum": [
            "not_implemented",
            "todo_comment",
            "none_bound_handler",
            "pass_bodied_abstract"
          ]
        },
        "detail": {"type": "string", "minLength": 1, "maxLength": 1024},
        "gate": {"enum": ["fail_closed", "advisory"]}
      }
    },
    "coverage_gap_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "entrypoint_count", "files_scanned", "gaps", "identity"],
      "properties": {
        "schema": {"const": "literate-ai/coverage-gap-report@3"},
        "entrypoint_count": {"type": "integer", "minimum": 0, "maximum": 65536},
        "files_scanned": {"type": "integer", "minimum": 0, "maximum": 4096},
        "gaps": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/coverage_gap"}
        },
        "identity": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "gpu_requirement": {
      "$id": "urn:literate-ai:schema:v1:gpu-requirement",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "vendor", "model", "minimum_count", "minimum_memory_mib", "capabilities"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:gpu-requirement"},
        "vendor": {"oneOf": [{"type": "null"}, {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}]},
        "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "minimum_count": {"type": ["integer", "null"], "minimum": 1, "maximum": 1024},
        "minimum_memory_mib": {"type": ["integer", "null"], "minimum": 1},
        "capabilities": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "items": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}
        }
      }
    },
    "execution_requirements": {
      "$id": "urn:literate-ai:schema:v1:execution-requirements",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "os_family", "os_version", "cpu_architecture", "minimum_cpu_cores", "minimum_memory_mib", "gpu"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:execution-requirements"},
        "os_family": {"type": ["string", "null"], "enum": ["linux", "macos", "windows", null]},
        "os_version": {"oneOf": [{"type": "null"}, {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}]},
        "cpu_architecture": {"oneOf": [{"type": "null"}, {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}]},
        "minimum_cpu_cores": {"type": ["integer", "null"], "minimum": 1, "maximum": 65536},
        "minimum_memory_mib": {"type": ["integer", "null"], "minimum": 1},
        "gpu": {"$ref": "urn:literate-ai:schema:v1:gpu-requirement"}
      }
    },
    "worker_parameter": {
      "$id": "urn:literate-ai:schema:v1:execution-worker-parameter",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name", "allowed_values", "required", "default"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:execution-worker-parameter"},
        "name": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_name"},
        "allowed_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}},
        "required": {"type": "boolean"},
        "default": {"oneOf": [{"type": "null"}, {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}]}
      }
    },
    "worker_parameter_value": {
      "$id": "urn:literate-ai:schema:v1:execution-worker-parameter-value",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name", "value"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:execution-worker-parameter-value"},
        "name": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_name"},
        "value": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}
      }
    },
    "worker_environment": {
      "$id": "urn:literate-ai:schema:v1:execution-worker-environment",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name", "source_variable", "required"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:execution-worker-environment"},
        "name": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$", "maxLength": 128},
        "source_variable": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$", "maxLength": 128},
        "required": {"type": "boolean"}
      }
    },
    "execution_worker": {
      "$id": "urn:literate-ai:schema:v1:execution-worker",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "worker_id", "kind", "target_profile", "requirements", "parameters", "endpoint", "workspace", "command", "environment", "transport"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:execution-worker"},
        "worker_id": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_id"},
        "kind": {"enum": ["local", "ssh", "command"]},
        "target_profile": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_id"},
        "requirements": {"$ref": "urn:literate-ai:schema:v1:execution-requirements"},
        "parameters": {"type": "array", "maxItems": 64, "items": {"$ref": "urn:literate-ai:schema:v1:execution-worker-parameter"}},
        "endpoint": {"type": ["string", "null"], "maxLength": 4096},
        "workspace": {"type": ["string", "null"], "maxLength": 4096},
        "command": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "environment": {"type": "array", "items": {"$ref": "urn:literate-ai:schema:v1:execution-worker-environment"}},
        "transport": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"},
        "lifecycle_executable": {"type": ["string", "null"], "maxLength": 4096, "pattern": "^(?:~/|/)[A-Za-z0-9._/-]+$"},
        "slots": {"type": "integer", "minimum": 1, "maximum": 256},
        "action_protocol": {"enum": [null, "literate-ai/lifecycle-action-wire@1"]},
        "action_command": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\x00\\r\\n]+$"}}
      },
      "allOf": [
        {
          "if": {"required": ["action_command"], "properties": {"action_command": {"minItems": 1}}},
          "then": {"required": ["action_protocol"], "properties": {"kind": {"const": "ssh"}, "action_protocol": {"const": "literate-ai/lifecycle-action-wire@1"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "local"}}},
          "then": {"properties": {"endpoint": {"type": "null"}, "workspace": {"type": "null"}, "command": {"maxItems": 0}, "environment": {"maxItems": 0}, "transport": {"const": "ssh"}, "lifecycle_executable": {"type": "null"}, "action_protocol": {"type": "null"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "ssh"}}},
          "then": {"properties": {"endpoint": {"type": "string", "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9._:-]+$"}, "workspace": {"type": "string", "pattern": "^(?:~/|/)[A-Za-z0-9._/-]+$"}, "command": {"maxItems": 0}, "environment": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"kind": {"const": "command"}}},
          "then": {"properties": {"endpoint": {"type": "null"}, "workspace": {"type": "null"}, "command": {"minItems": 1}, "transport": {"const": "ssh"}, "lifecycle_executable": {"type": "null"}}}
        }
      ]
    },
    "worker_catalog": {
      "$id": "urn:literate-ai:schema:v1:execution-worker-catalog",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "workers"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:execution-worker-catalog"},
        "workers": {"type": "array", "minItems": 0, "maxItems": 256, "items": {"$ref": "urn:literate-ai:schema:v1:execution-worker"}}
      }
    },
    "observed_gpu_device": {
      "$id": "urn:literate-ai:schema:v1:observed-gpu-device",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "vendor", "model", "index", "uuid", "memory_mib", "compute_capability", "driver_version", "core_count"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:observed-gpu-device"},
        "vendor": {"enum": ["apple", "nvidia", "other"]},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "index": {"type": ["integer", "null"], "minimum": 0},
        "uuid": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "memory_mib": {"type": ["integer", "null"], "minimum": 1},
        "compute_capability": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "driver_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "core_count": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "worker_hardware_observation": {
      "$id": "urn:literate-ai:schema:v1:worker-hardware-observation",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "worker_id", "observed_at", "os_family", "os_name", "os_version", "cpu_architecture", "physical_cpu_cores", "logical_cpu_cores", "memory_mib", "gpus", "nvidia_status", "diagnostic"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:worker-hardware-observation"},
        "worker_id": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_id"},
        "observed_at": {"type": "string", "format": "date-time"},
        "os_family": {"enum": ["linux", "macos", "windows"]},
        "os_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "os_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "cpu_architecture": {"type": "string", "minLength": 1, "maxLength": 256},
        "physical_cpu_cores": {"type": "integer", "minimum": 1},
        "logical_cpu_cores": {"type": "integer", "minimum": 1},
        "memory_mib": {"type": "integer", "minimum": 1},
        "gpus": {"type": "array", "items": {"$ref": "urn:literate-ai:schema:v1:observed-gpu-device"}},
        "nvidia_status": {"enum": ["not-applicable", "absent", "ok", "degraded"]},
        "diagnostic": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048}
      }
    },
    "worker_hardware_observation_catalog": {
      "$id": "urn:literate-ai:schema:v1:worker-hardware-observation-catalog",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "workers"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:worker-hardware-observation-catalog"},
        "workers": {"type": "array", "maxItems": 256, "items": {"$ref": "urn:literate-ai:schema:v1:worker-hardware-observation"}}
      }
    },
    "source_materialization": {
      "$id": "urn:literate-ai:schema:v2:execution-source-materialization",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "request_identity", "source_tree_identity", "repository_url", "revision", "archive_reference"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:execution-source-materialization"},
        "kind": {"enum": ["git", "archive"]},
        "request_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "source_tree_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "repository_url": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "revision": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "archive_reference": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v1:content-reference"}
          ]
        },
        "accepted_source_cache_reference": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v1:content-reference"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "git"}}},
          "then": {
            "properties": {
              "repository_url": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
              "archive_reference": {"type": "null"},
              "accepted_source_cache_reference": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "repository_url": {"type": "null"},
              "revision": {"type": "null"},
              "archive_reference": {"$ref": "urn:literate-ai:schema:v1:content-reference"}
            }
          }
        }
      ]
    },
    "dispatch_request": {
      "$id": "urn:literate-ai:schema:v2:execution-dispatch-request",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "action", "component", "component_path", "target_profile", "flavor_selectors", "worker_identity", "requirements", "parameters", "arguments", "project_identity", "source_identity", "specification_identity", "flavor_identity", "toolchain_identity", "source_index_identity", "model_scope_identity", "artifact_reference", "timeout_seconds", "model_selector", "verbose"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:execution-dispatch-request"},
        "action": {"enum": ["build", "test", "run"]},
        "component": {"type": "string", "minLength": 1, "maxLength": 4096},
        "component_path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)(?!.*\\\\).+$"},
        "target_profile": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_id"},
        "flavor_selectors": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000\\r\\n]+$"}},
        "worker_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "requirements": {"$ref": "urn:literate-ai:schema:v1:execution-requirements"},
        "parameters": {"type": "array", "maxItems": 64, "items": {"$ref": "urn:literate-ai:schema:v1:execution-worker-parameter-value"}},
        "arguments": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 4096}},
        "project_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "source_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "specification_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "flavor_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "toolchain_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "source_index_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "model_scope_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "artifact_reference": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v1:content-reference"}
          ]
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "jobs": {"type": "integer", "minimum": 1, "maximum": 256},
        "model_selector": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}
          ]
        },
        "verbose": {"type": "boolean"},
        "accepted_source_only": {"type": "boolean"},
        "accepted_source_provider_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "accepted_source_provider_identity": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v1:content-identity"}
          ]
        },
        "entrypoint": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$"}
      }
    },
    "observed_environment": {
      "$id": "urn:literate-ai:schema:v2:observed-execution-environment",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "os_family", "os_version", "cpu_architecture", "cpu_cores", "memory_mib", "gpu_vendor", "gpu_model", "gpu_count", "gpu_memory_mib", "gpu_capabilities", "toolchain_identities"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:observed-execution-environment"},
        "os_family": {"enum": ["linux", "macos", "windows"]},
        "os_version": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"},
        "cpu_architecture": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"},
        "cpu_cores": {"type": "integer", "minimum": 1, "maximum": 65536},
        "memory_mib": {"type": "integer", "minimum": 1},
        "gpu_vendor": {"oneOf": [{"type": "null"}, {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}]},
        "gpu_model": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "gpu_count": {"type": "integer", "minimum": 0, "maximum": 1024},
        "gpu_memory_mib": {"type": ["integer", "null"], "minimum": 1},
        "gpu_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:literate-ai:schema:v2:execution-dispatch-contracts#/$defs/portable_value"}},
        "toolchain_identities": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"$ref": "urn:literate-ai:schema:v1:content-identity"}}
      }
    },
    "remote_evidence_file": {
      "$id": "urn:literate-ai:schema:v1:remote-evidence-file",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "path", "kind", "size", "identity", "executable"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:remote-evidence-file"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
        "kind": {"enum": ["artifact", "binary", "diagnostic", "log", "manifest", "object", "package", "receipt", "source", "test"]},
        "size": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "executable": {"type": "boolean"}
      }
    },
    "remote_failure_diagnostic": {
      "$id": "urn:literate-ai:schema:v1:remote-failure-diagnostic",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "code", "message", "nested_code", "nested_message", "stdout", "stderr", "redaction_policy"],
      "properties": {
