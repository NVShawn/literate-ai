{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:authored-qualification-result",
  "title": "Complete authored all-node clean run observations; receiving must reopen authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan",
    "runs"
  ],
  "properties": {
    "schema": {
      "const": "urn:literate-ai:schema:v2:authored-qualification-result"
    },
    "plan": {
      "$ref": "urn:literate-ai:schema:v2:authored-qualification-plan"
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:literate-ai:schema:v2:authored-qualification-run"
      }
    }
  }
}
