{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:flavor-contracts",
  "oneOf": [
    { "$ref": "urn:literate-ai:schema:v2:flavor-definition" }, { "$ref": "urn:literate-ai:schema:v2:flavor-revision" }, { "$ref": "urn:literate-ai:schema:v2:target-profile" },
    { "$ref": "urn:literate-ai:schema:v2:flavor-set-lock" }, { "$ref": "urn:literate-ai:schema:v2:effective-specification-set" }, { "$ref": "urn:literate-ai:schema:v2:effective-revision" }, { "$ref": "urn:literate-ai:schema:v2:toolchain-constraint" }
  ],
  "$defs": {
    "axis": { "$id": "urn:literate-ai:schema:v2:flavor-axis", "enum": ["platform.os", "platform.architecture", "accelerator", "implementation.language-ecosystem", "implementation.ui-framework", "build.system", "toolchain", "packaging", "deployment", "documentation.ecosystem"] },
    "coordinate": { "type": "object", "additionalProperties": false, "required": ["namespace", "name"], "properties": { "namespace": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } } },
    "constraint": { "type": "object", "additionalProperties": false, "required": ["axis", "value", "optional"], "properties": { "axis": { "$ref": "urn:literate-ai:schema:v2:flavor-axis" }, "value": { "type": "string", "minLength": 1 }, "optional": { "type": "boolean" }, "slot_id": { "type": "string", "minLength": 1 } } },
    "contribution": { "type": "object", "additionalProperties": false, "required": ["contribution_id", "kind", "merge_operator", "slot", "content"], "properties": { "contribution_id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["capability", "requirement", "specification", "workflow", "authoring-skill", "validator", "builder", "toolchain", "packaging", "runtime", "source-dependency", "extension"] }, "merge_operator": { "enum": ["additive-set", "keyed-union", "exact-singleton", "explicit-conflict"] }, "slot": { "type": "string", "minLength": 1 }, "content": { "$ref": "urn:literate-ai:schema:v1:content-reference" } } },
    "coRequisiteGroup": { "type": "object", "additionalProperties": false, "required": ["group_id", "alternatives"], "properties": { "group_id": { "type": "string", "minLength": 1 }, "alternatives": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^flavor://[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$" } } } },
    "toolchainConstraint": { "$id": "urn:literate-ai:schema:v2:toolchain-constraint", "type": "object", "additionalProperties": false, "required": ["schema", "toolchain"], "properties": { "schema": { "const": "urn:literate-ai:schema:v2:toolchain-constraint" }, "toolchain": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$" }, "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "minimum_version": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/versionPrefix" }, "required_version": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/versionPrefix" }, "maximum_exclusive_version": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/versionPrefix" }, "remediation": { "type": "string", "minLength": 1, "maxLength": 1024 }, "remediation_uri": { "type": "string", "format": "uri", "pattern": "^https://" } } },
    "definition": {
      "$id": "urn:literate-ai:schema:v2:flavor-definition", "type": "object", "additionalProperties": false,
      "required": ["schema", "coordinate", "version", "display_name", "primary_axis", "secondary_constraints", "applicable_capabilities", "provides", "requires", "specification_fragments", "authoring_inputs", "contributions", "conflicts", "co_requisites", "order_before", "order_after", "supported_targets"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:flavor-definition" }, "coordinate": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/coordinate" }, "version": { "$ref": "urn:literate-ai:schema:v1:identity-contracts#/$defs/semver" }, "display_name": { "type": "string", "minLength": 1 }, "primary_axis": { "$ref": "urn:literate-ai:schema:v2:flavor-axis" }, "secondary_constraints": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/constraint" } },
        "applicable_capabilities": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/stringArray" }, "provides": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:capability" } }, "requires": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:capability-requirement" } }, "specification_fragments": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/referenceArray" }, "authoring_inputs": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/referenceArray" }, "contributions": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/contribution" } },
        "conflicts": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/stringArray" }, "co_requisites": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/stringArray" }, "co_requisite_groups": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/coRequisiteGroup" } }, "order_before": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/stringArray" }, "order_after": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/stringArray" }, "supported_targets": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "provider_overrides": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:literate-ai:schema:v2:provider-override-declaration" } }
      }
    },
    "revision": { "$id": "urn:literate-ai:schema:v2:flavor-revision", "type": "object", "additionalProperties": false, "required": ["schema", "definition", "source_snapshot", "parent_revisions"], "properties": { "schema": { "const": "urn:literate-ai:schema:v2:flavor-revision" }, "definition": { "$ref": "urn:literate-ai:schema:v2:flavor-definition" }, "source_snapshot": { "oneOf": [{ "$ref": "urn:literate-ai:schema:v1:content-identity" }, { "type": "null" }] }, "parent_revisions": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/identityArray" } } },
    "targetProfile": { "$id": "urn:literate-ai:schema:v2:target-profile", "type": "object", "additionalProperties": false, "required": ["schema", "profile_id", "version", "provider", "provider_configuration", "constraints"], "properties": { "schema": { "const": "urn:literate-ai:schema:v2:target-profile" }, "profile_id": { "type": "string", "minLength": 1 }, "version": { "$ref": "urn:literate-ai:schema:v1:identity-contracts#/$defs/semver" }, "provider": { "type": "string", "minLength": 1 }, "provider_configuration": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "constraints": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/constraint" } } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["flavor_revision", "status", "reasons"], "properties": { "flavor_revision": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "status": { "enum": ["selected", "rejected", "conflict", "unavailable"] }, "reasons": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/stringArray" } } },
    "lock": { "$id": "urn:literate-ai:schema:v2:flavor-set-lock", "type": "object", "additionalProperties": false, "required": ["schema", "base_revision", "target_profile", "resolution_policy", "candidates", "selected_revisions", "base_component", "selected_flavors"], "properties": { "schema": { "const": "urn:literate-ai:schema:v2:flavor-set-lock" }, "base_revision": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "target_profile": { "$ref": "urn:literate-ai:schema:v2:target-profile" }, "resolution_policy": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "candidates": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/candidate" } }, "selected_revisions": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/identityArray" }, "base_component": { "$ref": "urn:literate-ai:schema:v1:component-revision-reference" }, "selected_flavors": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:versioned-content-reference" } } } },
    "effectiveSpecs": { "$id": "urn:literate-ai:schema:v2:effective-specification-set", "type": "object", "additionalProperties": false, "required": ["schema", "base_specification_set", "flavor_specification_fragments", "flavor_set_lock", "diagnostics"], "properties": { "schema": { "const": "urn:literate-ai:schema:v2:effective-specification-set" }, "base_specification_set": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "flavor_specification_fragments": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/identityArray" }, "flavor_set_lock": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "diagnostics": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/stringArray" } } },
    "effectiveRevision": { "$id": "urn:literate-ai:schema:v2:effective-revision", "type": "object", "additionalProperties": false, "required": ["schema", "base_revision", "target_profile", "flavor_set_lock", "effective_specification_set", "contributions", "resolver_policy"], "properties": { "schema": { "const": "urn:literate-ai:schema:v2:effective-revision" }, "base_revision": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "target_profile": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "flavor_set_lock": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "effective_specification_set": { "$ref": "urn:literate-ai:schema:v1:content-identity" }, "contributions": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v2:flavor-contracts#/$defs/contribution" } }, "resolver_policy": { "$ref": "urn:literate-ai:schema:v1:content-identity" } } },
    "identityArray": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:content-identity" } },
    "referenceArray": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v1:content-reference" } },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "versionPrefix": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "integer", "minimum": 0 } }
  }
}
