{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:model-scope-binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope_kind",
    "owner_identity",
    "parent_binding_identity",
    "provider_id",
    "model_selector",
    "resolution_trace"
  ],
  "properties": {
    "schema": {"const": "urn:literate-ai:schema:v2:model-scope-binding"},
    "scope_kind": {
      "enum": ["pipeline", "component", "flavor-role", "skill-invocation"]
    },
    "owner_identity": {"$ref": "#/$defs/identity"},
    "parent_binding_identity": {
      "oneOf": [
        {"$ref": "#/$defs/identity"},
        {"type": "null"}
      ]
    },
    "provider_id": {"enum": ["codex", "claude", "cursor-agent", "opencode"]},
    "model_selector": {"type": "string", "minLength": 1, "maxLength": 4096},
    "resolution_trace": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/resolution_step"}
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "algorithm", "digest"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:content-identity"},
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "resolution_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_kind",
        "owner_identity",
        "candidate_owner_identities",
        "configured_selectors",
        "selected_selector",
        "decision"
      ],
      "properties": {
        "scope_kind": {
          "enum": ["pipeline", "component", "flavor-role", "skill-invocation"]
        },
        "owner_identity": {"$ref": "#/$defs/identity"},
        "candidate_owner_identities": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/identity"}
        },
        "configured_selectors": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "selected_selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "decision": {"enum": ["default", "inherit", "override"]}
      }
    }
  }
}
