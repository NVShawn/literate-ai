{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:native-sdk-tree-products@1",
  "oneOf": [
    {
      "$ref": "urn:literate-ai:schema:v2:native-sdk-tree-snapshot@1"
    },
    {
      "$ref": "urn:literate-ai:schema:v2:native-sdk-tree-build-layout@1"
    },
    {
      "$ref": "urn:literate-ai:schema:v2:native-sdk-tree-build-recipe@1"
    }
  ],
  "$defs": {
    "snapshot": {
      "$id": "urn:literate-ai:schema:v2:native-sdk-tree-snapshot@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_lock_identity",
        "recipe_identity",
        "target_identity",
        "license_identity",
        "schema",
        "import_surface",
        "import_root",
        "native_libraries",
        "tree"
      ],
      "properties": {
        "source_lock_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "recipe_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "target_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "license_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "schema": {
          "const": "urn:literate-ai:schema:v2:native-sdk-tree-snapshot@1"
        },
        "import_surface": {
          "$ref": "urn:literate-ai:schema:v2:library-import-surface@1"
        },
        "import_root": {
          "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
        },
        "native_libraries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
          }
        },
        "tree": {
          "$ref": "urn:literate-ai:schema:v2:native-sdk-tree@1"
        }
      }
    },
    "build-layout": {
      "$id": "urn:literate-ai:schema:v2:native-sdk-tree-build-layout@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sdk_root",
        "import_root",
        "source_license",
        "output_license",
        "license_identity",
        "import_surface",
        "native_libraries",
        "operating_system",
        "architecture",
        "limits",
        "case_sensitive"
      ],
      "properties": {
        "schema": {
          "const": "urn:literate-ai:schema:v2:native-sdk-tree-build-layout@1"
        },
        "sdk_root": {
          "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
        },
        "import_root": {
          "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
        },
        "source_license": {
          "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
        },
        "output_license": {
          "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
        },
        "license_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "import_surface": {
          "$ref": "urn:literate-ai:schema:v2:library-import-surface@1"
        },
        "native_libraries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
          }
        },
        "operating_system": {
          "enum": [
            "freebsd",
            "linux",
            "macos",
            "windows"
          ]
        },
        "architecture": {
          "enum": [
            "x86_64",
            "arm64"
          ]
        },
        "case_sensitive": {
          "type": "boolean"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_entries",
            "max_file_bytes",
            "max_total_bytes"
          ],
          "properties": {
            "max_entries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_file_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_total_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        }
      }
    },
    "build-recipe": {
      "$id": "urn:literate-ai:schema:v2:native-sdk-tree-build-recipe@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "dependency_id",
        "layout",
        "tools",
        "commands"
      ],
      "properties": {
        "schema": {
          "const": "urn:literate-ai:schema:v2:native-sdk-tree-build-recipe@1"
        },
        "dependency_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
        },
        "layout": {
          "$ref": "urn:literate-ai:schema:v2:native-sdk-tree-build-layout@1"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "urn:literate-ai:schema:v1:repository-source-contracts#/$defs/command"
          }
        }
      }
    }
  }
}
