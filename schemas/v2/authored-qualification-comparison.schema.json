{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:authored-qualification-comparison",
  "title": "Authored native observations compared with sealed oracle; no original-source baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origin",
    "plan_identity",
    "run_identity",
    "oracle_set_identity",
    "independent_acceptance_identity",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "urn:literate-ai:schema:v2:authored-qualification-comparison"
    },
    "origin": {
      "$ref": "urn:literate-ai:schema:v2:authored-qualification-origin"
    },
    "plan_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "run_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "oracle_set_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "independent_acceptance_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:literate-ai:schema:v2:authored-node-independent-acceptance"
      }
    }
  }
}
