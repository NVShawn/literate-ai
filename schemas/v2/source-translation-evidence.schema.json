{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:source-translation-evidence-contracts",
  "oneOf": [
    { "$ref": "urn:literate-ai:schema:v2:source-to-specification-intelligence" },
    { "$ref": "urn:literate-ai:schema:v2:source-to-specification-translation-run" }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "language": {
      "enum": ["cpp", "javascript", "python", "rust"]
    },
    "indexedSourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "identity"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "identity": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/identity" }
      }
    },
    "intelligence": {
      "$id": "urn:literate-ai:schema:v2:source-to-specification-intelligence",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority_source_snapshot_id",
        "indexed_source_snapshot_id",
        "indexed_source_tree_id",
        "indexed_source_files",
        "source_content_identity",
        "source_material_identity",
        "index_evidence_identity",
        "provider_id",
        "provider_version",
        "runtime_version",
        "executable_identity",
        "database_identity",
        "built_with_version",
        "extraction_version",
        "document_count",
        "node_count",
        "edge_count",
        "languages",
        "evidence",
        "queries"
      ],
      "properties": {
        "schema": {
          "const": "urn:literate-ai:schema:v2:source-to-specification-intelligence"
        },
        "authority_source_snapshot_id": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/identity" },
        "indexed_source_snapshot_id": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/identity" },
        "indexed_source_tree_id": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/identity" },
        "indexed_source_files": {
          "type": "array",
          "items": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/indexedSourceFile" }
        },
        "source_content_identity": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/identity" },
        "source_material_identity": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/identity" },
        "index_evidence_identity": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/identity" },
        "provider_id": { "type": "string", "minLength": 1 },
        "provider_version": { "type": "string", "minLength": 1 },
        "runtime_version": { "type": "string", "minLength": 1 },
        "executable_identity": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/identity" },
        "database_identity": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/identity" },
        "built_with_version": { "type": "string", "minLength": 1 },
        "extraction_version": { "type": "integer", "minimum": 0 },
        "document_count": { "type": "integer", "minimum": 0 },
        "node_count": { "type": "integer", "minimum": 0 },
        "edge_count": { "type": "integer", "minimum": 0 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "urn:literate-ai:schema:v2:source-translation-evidence-contracts#/$defs/language" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:literate-ai:schema:v1:source-translation-contracts#/$defs/modelEvidence"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "urn:literate-ai:schema:v1:source-translation-contracts#/$defs/query"
          }
        }
      }
    },
    "translationRun": {
      "$id": "urn:literate-ai:schema:v2:source-to-specification-translation-run",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "mode", "intelligence", "journals"],
      "properties": {
        "schema": {
          "const": "urn:literate-ai:schema:v2:source-to-specification-translation-run"
        },
        "mode": { "enum": ["deterministic-static", "coding-cli"] },
        "intelligence": {
          "oneOf": [
            { "$ref": "urn:literate-ai:schema:v2:source-to-specification-intelligence" },
            { "type": "null" }
          ]
        },
        "journals": {
          "type": "array",
          "items": {
            "$ref": "urn:literate-ai:schema:v1:source-to-specification-model-call-journal"
          }
        }
      }
    }
  }
}
