      "$id": "urn:literate-ai:schema:v2:component-graph-draft"
    },
    "result": {
      "$id": "urn:literate-ai:schema:v2:source-to-specification-result",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
