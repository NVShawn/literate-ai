          "const": "urn:literate-ai:schema:v2:source-to-specification-result"
        },
        "request": {
          "$ref": "urn:literate-ai:schema:v2:source-to-specification-request"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "urn:literate-ai:schema:v2:behavior-observation"
          }
        },
        "draft": {
          "$ref": "urn:literate-ai:schema:v2:specification-draft-set"
        },
        "coverage": {
          "$ref": "urn:literate-ai:schema:v2:source-specification-coverage-map"
        },
        "uncertainty": {
          "$ref": "urn:literate-ai:schema:v2:uncertainty-ledger"
        },
        "run": {
