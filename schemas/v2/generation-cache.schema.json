{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:generation-cache-contracts",
  "oneOf": [
    {"$ref": "urn:literate-ai:schema:v2:source-cache-model-binding"},
    {"$ref": "urn:literate-ai:schema:v1:accepted-source-lookup-key"},
    {"$ref": "urn:literate-ai:schema:v2:source-derivation-cache-key"},
    {"$ref": "urn:literate-ai:schema:v2:accepted-source-derivation"},
    {"$ref": "urn:literate-ai:schema:v2:source-cache-target"},
    {"$ref": "urn:literate-ai:schema:v2:source-cache-configuration"},
    {"$ref": "urn:literate-ai:schema:v2:cached-source-file"},
    {"$ref": "urn:literate-ai:schema:v2:accepted-source-cache-entry"},
    {"$ref": "urn:literate-ai:schema:v1:source-intelligence-attachment"},
    {"$ref": "urn:literate-ai:schema:v1:source-intelligence-artifact"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "portableId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "modelBinding": {
      "$id": "urn:literate-ai:schema:v2:source-cache-model-binding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider_id",
        "model_selector",
        "exact_revision_identity"
      ],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:source-cache-model-binding"},
        "provider_id": {"type": "string", "minLength": 1},
        "model_selector": {"type": "string", "minLength": 1},
        "exact_revision_identity": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v1:content-identity"}
          ]
        }
      }
    },
    "acceptedSourceLookupKey": {
      "$id": "urn:literate-ai:schema:v1:accepted-source-lookup-key",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "recipe_identity",
        "execution_plan_identity",
        "coding_cli_tool_binding_identity",
        "model_binding",
        "source_semantics_identity"
      ],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:accepted-source-lookup-key"},
        "recipe_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "execution_plan_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "coding_cli_tool_binding_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "model_binding": {"$ref": "urn:literate-ai:schema:v2:source-cache-model-binding"},
        "source_semantics_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"}
      }
    },
    "cacheKey": {
      "$id": "urn:literate-ai:schema:v2:source-derivation-cache-key",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "recipe_identity",
        "execution_plan_identity",
        "coding_cli_tool_binding_identity",
        "model_binding",
        "request_identity",
        "source_semantics_identity"
      ],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:source-derivation-cache-key"},
        "recipe_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "execution_plan_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "coding_cli_tool_binding_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "model_binding": {"$ref": "urn:literate-ai:schema:v2:source-cache-model-binding"},
        "request_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "source_semantics_identity": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v1:content-identity"}
          ]
        }
      }
    },
    "accepted": {
      "$id": "urn:literate-ai:schema:v2:accepted-source-derivation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "cache_key",
        "component_lock_identity",
        "source_tree_identity",
        "managed_sbom_graph_identity",
        "source_sbom_identity",
        "resolved_sbom_identity",
        "source_sbom_binding",
        "resolved_sbom_binding",
        "generated_test_suite_identity",
        "build_evidence_identity",
        "test_evidence_identity",
        "acceptance_identity",
        "provenance_identity"
      ],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:accepted-source-derivation"},
        "cache_key": {"$ref": "urn:literate-ai:schema:v2:source-derivation-cache-key"},
        "component_lock_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "source_tree_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "managed_sbom_graph_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "source_sbom_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "resolved_sbom_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "source_sbom_binding": {"$ref": "urn:literate-ai:schema:v2:cyclonedx-bom-binding"},
        "resolved_sbom_binding": {"$ref": "urn:literate-ai:schema:v2:cyclonedx-bom-binding"},
        "generated_test_suite_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "build_evidence_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "test_evidence_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "acceptance_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "provenance_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"}
      }
    },
    "target": {
      "$id": "urn:literate-ai:schema:v2:source-cache-target",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "target_id", "format", "root_kind", "root_reference"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:source-cache-target"},
        "target_id": {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/portableId"},
        "format": {"enum": ["filesystem-v1", "filesystem-v2"]},
        "root_kind": {"enum": ["project-relative", "operator-bound"]},
        "root_reference": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"root_kind": {"const": "operator-bound"}}, "required": ["root_kind"]},
          "then": {
            "properties": {
              "root_reference": {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/portableId"}
            }
          }
        }
      ]
    },
    "configuration": {
      "$id": "urn:literate-ai:schema:v2:source-cache-configuration",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "mode", "targets", "write_target_id", "require_unique"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:source-cache-configuration"},
        "mode": {"enum": ["off", "read-only", "write-only", "read-write"]},
        "targets": {
          "type": "array",
          "items": {"$ref": "urn:literate-ai:schema:v2:source-cache-target"}
        },
        "write_target_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/portableId"}
          ]
        },
        "require_unique": {"type": "boolean", "default": true}
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"enum": ["write-only", "read-write"]}},
            "required": ["mode"]
          },
          "then": {"properties": {"write_target_id": {"type": "string"}}},
          "else": {"properties": {"write_target_id": {"type": "null"}}}
        }
      ]
    },
    "sourceFile": {
      "$id": "urn:literate-ai:schema:v2:cached-source-file",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "path", "blob"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:cached-source-file"},
        "path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"},
        "blob": {"$ref": "urn:literate-ai:schema:v1:blob-ref"}
      }
    },
    "sourceIntelligence": {
      "$id": "urn:literate-ai:schema:v1:source-intelligence-artifact",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "provider_id",
        "provider_version",
        "runtime_version",
        "executable_identity",
        "source_tree_identity",
        "source_snapshot_identity",
        "capabilities",
        "provider_properties",
        "logical_intelligence_identity",
        "artifact_binding",
        "intelligence_identity",
        "artifact_path",
        "artifact_media_type",
        "artifact_identity",
        "document_count",
        "symbol_count",
        "relationship_count",
        "unresolved_relationship_count",
        "warning_count"
      ],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:source-intelligence-artifact"},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "executable_identity": {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/digest"},
        "source_tree_identity": {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/digest"},
        "source_snapshot_identity": {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/digest"},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"}
        },
        "provider_properties": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?=[^\\r\\n]{1,512}$"}
        },
        "logical_intelligence_identity": {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/digest"},
        "artifact_binding": {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/digest"},
        "intelligence_identity": {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/digest"},
        "artifact_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\\\]+$"},
        "artifact_media_type": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"},
        "artifact_identity": {"$ref": "urn:literate-ai:schema:v2:generation-cache-contracts#/$defs/digest"},
        "document_count": {"type": "integer", "minimum": 0},
        "symbol_count": {"type": "integer", "minimum": 0},
        "relationship_count": {"type": "integer", "minimum": 0},
        "unresolved_relationship_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"document_count": {"const": 0}}, "required": ["document_count"]},
          "then": {
            "properties": {
              "symbol_count": {"const": 0},
              "relationship_count": {"const": 0},
              "unresolved_relationship_count": {"const": 0}
            }
          }
        }
      ]
    },
    "entry": {
      "$id": "urn:literate-ai:schema:v2:accepted-source-cache-entry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "derivation",
        "source_files",
        "managed_sbom_graph",
        "source_sbom",
        "resolved_sbom",
        "generated_test_suite",
        "build_evidence",
        "test_evidence",
        "acceptance_evidence",
        "provenance_evidence",
        "repository_resolutions"
      ],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:accepted-source-cache-entry"},
        "derivation": {"$ref": "urn:literate-ai:schema:v2:accepted-source-derivation"},
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "urn:literate-ai:schema:v2:cached-source-file"}
        },
        "managed_sbom_graph": {"$ref": "urn:literate-ai:schema:v2:cyclonedx-managed-graph"},
        "source_sbom": {"$ref": "urn:literate-ai:schema:v1:blob-ref"},
        "resolved_sbom": {"$ref": "urn:literate-ai:schema:v1:blob-ref"},
        "generated_test_suite": {"$ref": "urn:literate-ai:schema:v1:blob-ref"},
        "build_evidence": {"$ref": "urn:literate-ai:schema:v1:blob-ref"},
        "test_evidence": {"$ref": "urn:literate-ai:schema:v1:blob-ref"},
        "acceptance_evidence": {"$ref": "urn:literate-ai:schema:v1:blob-ref"},
        "provenance_evidence": {"$ref": "urn:literate-ai:schema:v1:blob-ref"},
        "repository_resolutions": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "urn:literate-ai:schema:v1:cyclonedx-repository-source-resolution"}
        }
      }
    },
    "intelligenceAttachment": {
      "$id": "urn:literate-ai:schema:v1:source-intelligence-attachment",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source_tree_identity", "intelligence", "artifact"],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v1:source-intelligence-attachment"},
        "source_tree_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "intelligence": {"$ref": "urn:literate-ai:schema:v1:source-intelligence-artifact"},
        "artifact": {"$ref": "urn:literate-ai:schema:v1:blob-ref"}
      }
    }
  }
}
