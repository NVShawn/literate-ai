{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "literate-ai/native-cli-acceptance@2",
  "title": "Native CLI independent acceptance contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component",
    "entrypoint",
    "specification_set_identity",
    "environment",
    "cases",
    "stdout_limit_bytes",
    "stderr_limit_bytes",
    "filesystem_limit_bytes"
  ],
  "properties": {
    "schema": { "const": "literate-ai/native-cli-acceptance@2" },
    "component": { "$ref": "#/$defs/name" },
    "entrypoint": { "$ref": "#/$defs/name" },
    "specification_set_identity": { "$ref": "#/$defs/identity" },
    "environment": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^(?!.*(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]))[A-Za-z_][A-Za-z0-9_]{0,126}$"
      },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/case" }
    },
    "stdout_limit_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "stderr_limit_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "filesystem_limit_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}$" },
    "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[^\\\\\\u0000]+$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_base64", "utf8_contains", "utf8_not_contains"],
      "properties": {
        "exact_base64": { "type": ["string", "null"], "maxLength": 357913948 },
        "utf8_contains": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "uniqueItems": true
        },
        "utf8_not_contains": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "exact_base64": { "type": "string" },
            "utf8_contains": { "maxItems": 0 },
            "utf8_not_contains": { "maxItems": 0 }
          }
        },
        {
          "properties": { "exact_base64": { "type": "null" } },
          "anyOf": [
            { "properties": { "utf8_contains": { "minItems": 1 } } },
            { "properties": { "utf8_not_contains": { "minItems": 1 } } }
          ]
        }
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "content_base64"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "mode": { "type": "integer", "minimum": 1, "maximum": 511 },
        "content_base64": { "type": "string", "maxLength": 22369628 }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "mode", "maximum_bytes", "content"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "kind": { "enum": ["directory", "file"] },
        "mode": { "type": "integer", "minimum": 1, "maximum": 511 },
        "maximum_bytes": { "type": "integer", "minimum": 0, "maximum": 268435456 },
        "content": { "oneOf": [{ "$ref": "#/$defs/content" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "directory" } } },
          "then": {
            "properties": {
              "maximum_bytes": { "const": 0 },
              "content": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "maximum_bytes": { "minimum": 1 },
              "content": { "$ref": "#/$defs/content" }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "arguments",
        "stdin_base64",
        "expected_exit_code",
        "stdout",
        "stderr",
        "fixtures",
        "filesystem",
        "timeout_seconds"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/name" },
        "arguments": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "stdin_base64": { "type": ["string", "null"], "maxLength": 22369628 },
        "expected_exit_code": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "const": "nonzero" }
          ]
        },
        "stdout": { "$ref": "#/$defs/content" },
        "stderr": { "$ref": "#/$defs/content" },
        "fixtures": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/fixture" }
        },
        "filesystem": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/filesystem" }
        },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 }
      }
    }
  }
}
