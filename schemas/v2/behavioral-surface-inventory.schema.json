{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v1:behavioral-surface-inventory",
  "title": "Behavioral surface inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_snapshot_identity",
    "collector_identity",
    "translator_identity",
    "surfaces"
  ],
  "properties": {
    "schema": { "const": "urn:literate-ai:schema:v1:behavioral-surface-inventory" },
    "source_snapshot_identity": { "$ref": "#/$defs/identity" },
    "collector_identity": { "$ref": "#/$defs/identity" },
    "translator_identity": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/identity" }
      ]
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": { "$ref": "urn:literate-ai:schema:v1:behavioral-surface-inventory-item" }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_snapshot_id",
        "content_digest",
        "path",
        "symbol"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_snapshot_id": { "$ref": "#/$defs/identity" },
        "content_digest": { "$ref": "#/$defs/identity" },
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" }
      }
    },
    "surface": {
      "$id": "urn:literate-ai:schema:v1:behavioral-surface-inventory-item",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "surface_id",
        "detector_identity",
        "language",
        "interface_kind",
        "path",
        "symbol",
        "evidence_ids",
        "requirement",
        "evidence",
        "disposition",
        "mapped_observation_ids",
        "exclusion_reason",
        "exclusion_review_identity"
      ],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v1:behavioral-surface-inventory-item" },
        "surface_id": { "$ref": "urn:literate-ai:schema:v1:behavioral-surface-inventory#/$defs/identity" },
        "detector_identity": { "$ref": "urn:literate-ai:schema:v1:behavioral-surface-inventory#/$defs/identity" },
        "language": { "type": "string", "minLength": 1 },
        "interface_kind": {
          "enum": [
            "entrypoint",
            "export",
            "io-protocol",
            "configuration",
            "error",
            "state",
            "ordering",
            "normalization",
            "test-observed",
            "component-boundary",
            "dependency-edge",
            "literal-data"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requirement": { "enum": ["required", "advisory"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:literate-ai:schema:v1:behavioral-surface-inventory#/$defs/evidenceReference" }
        },
        "disposition": { "enum": ["mapped", "unmapped", "excluded"] },
        "mapped_observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclusion_reason": { "type": ["string", "null"] },
        "exclusion_review_identity": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "urn:literate-ai:schema:v1:behavioral-surface-inventory#/$defs/identity" }
          ]
        }
      }
    }
  }
}
