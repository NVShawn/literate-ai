{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:package-tree-input@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "prefix",
    "role",
    "source_identity",
    "target_identity",
    "tree",
    "kind"
  ],
  "properties": {
    "schema": {
      "const": "urn:literate-ai:schema:v2:package-tree-input@1"
    },
    "prefix": {
      "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "target_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "tree": {
      "$ref": "urn:literate-ai:schema:v2:native-sdk-tree@1"
    },
    "kind": {
      "enum": [
        "artifact",
        "resource"
      ]
    }
  }
}
