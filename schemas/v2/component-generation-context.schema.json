{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:component-generation-context-contracts",
  "oneOf": [
    { "$ref": "#/$defs/contextManifest" },
    { "$ref": "#/$defs/complexityBudget" },
    { "$ref": "#/$defs/complexityDecision" },
    { "$ref": "#/$defs/boundedRequest" }
  ],
  "$defs": {
    "permittedAuthorityKind": {
      "enum": [
        "framework-envelope", "local-specification", "local-flavor", "local-skill",
        "local-workflow", "local-routing-policy", "local-public-interface", "local-asset-metadata", "local-native-sdk-metadata",
        "direct-public-interface"
      ]
    },
    "contextSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "authority_kind", "source_component_revision", "reason", "content_identity", "byte_count", "estimated_tokens", "visibility"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "authority_kind": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/permittedAuthorityKind" },
        "source_component_revision": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "urn:literate-ai:schema:v1:content-identity" }
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "content_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "byte_count": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
        "estimated_tokens": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
        "visibility": { "enum": ["framework", "local-authority", "direct-public-interface", "forbidden"] }
      }
    },
    "contextManifest": {
      "$id": "urn:literate-ai:schema:v2:component-generation-context-manifest",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "component_revision", "generation_key_identity", "segments"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:component-generation-context-manifest" },
        "component_revision": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "generation_key_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "segments": {
          "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
          "items": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/contextSegment" }
        }
      }
    },
    "complexityBudget": {
      "$id": "urn:literate-ai:schema:v2:generation-complexity-budget",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "max_prompt_bytes", "max_estimated_tokens", "max_document_count", "max_direct_interface_bytes", "max_dependency_fan_in", "max_model_attempts", "max_wall_time_ms", "max_model_tokens", "max_cost_microunits"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:generation-complexity-budget" },
        "max_prompt_bytes": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/positiveBound" },
        "max_estimated_tokens": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/positiveBound" },
        "max_document_count": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/positiveBound" },
        "max_direct_interface_bytes": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/positiveBound" },
        "max_dependency_fan_in": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/positiveBound" },
        "max_model_attempts": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/positiveBound" },
        "max_wall_time_ms": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/positiveBound" },
        "max_model_tokens": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/positiveBound" },
        "max_cost_microunits": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/positiveBound" }
      }
    },
    "positiveBound": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_identity", "authority_kind", "byte_count"],
      "properties": {
        "content_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "authority_kind": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/permittedAuthorityKind" },
        "byte_count": { "type": "integer", "minimum": 0, "maximum": 1099511627776 }
      }
    },
    "complexityDecision": {
      "$id": "urn:literate-ai:schema:v2:generation-complexity-decision",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "manifest_identity", "budget_identity", "prompt_bytes", "estimated_tokens", "document_count", "direct_interface_bytes", "dependency_fan_in", "allowed", "violations", "largest_local_contributors", "largest_interface_contributors"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:generation-complexity-decision" },
        "manifest_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "budget_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "prompt_bytes": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/nonnegativeBound" },
        "estimated_tokens": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/nonnegativeBound" },
        "document_count": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/nonnegativeBound" },
        "direct_interface_bytes": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/nonnegativeBound" },
        "dependency_fan_in": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/nonnegativeBound" },
        "allowed": { "type": "boolean" },
        "violations": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "largest_local_contributors": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/contributor" } },
        "largest_interface_contributors": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-contracts#/$defs/contributor" } }
      }
    },
    "nonnegativeBound": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "boundedRequest": {
      "$id": "urn:literate-ai:schema:v2:bounded-component-generation-request",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "component_generation_plan_identity", "generation_key_identity", "context_manifest_identity", "complexity_decision_identity", "context_manifest", "budget", "budget_decision", "prompt_identity"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:bounded-component-generation-request" },
        "component_generation_plan_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "generation_key_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "context_manifest_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "complexity_decision_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "context_manifest": { "$ref": "urn:literate-ai:schema:v2:component-generation-context-manifest" },
        "budget": { "$ref": "urn:literate-ai:schema:v2:generation-complexity-budget" },
        "budget_decision": { "$ref": "urn:literate-ai:schema:v2:generation-complexity-decision" },
        "prompt_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" }
      }
    }
  }
}
