{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:html-observability-sources",
  "oneOf": [
    { "$ref": "urn:literate-ai:schema:v2:html-performance-history" },
    { "$ref": "urn:literate-ai:schema:v2:html-workflow-routing-catalog" },
    { "$ref": "urn:literate-ai:schema:v1:html-observability-dashboard" }
  ],
  "$defs": {
    "performanceHistory": {
      "$id": "urn:literate-ai:schema:v2:html-performance-history",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "project_id", "spans", "truncated"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:html-performance-history" },
        "project_id": { "type": "string", "minLength": 1 },
        "spans": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "run_id", "stage", "target_kind", "target_id", "coding_cli", "model", "started_at", "ended_at", "duration_ms", "ok", "error_code", "extra"],
            "properties": {
              "schema": { "const": "urn:literate-ai:schema:v1:performance-span" },
              "run_id": { "type": "string", "minLength": 1 },
              "stage": { "type": "string", "minLength": 1 },
              "target_kind": { "type": "string", "minLength": 1 },
              "target_id": { "type": "string", "minLength": 1 },
              "coding_cli": { "type": ["string", "null"] },
              "model": { "type": ["string", "null"] },
              "started_at": { "type": "string", "minLength": 1 },
              "ended_at": { "type": "string", "minLength": 1 },
              "duration_ms": { "type": "integer", "minimum": 0 },
              "ok": { "type": "boolean" },
              "error_code": { "type": ["string", "null"] },
              "extra": { "type": "object" }
            }
          }
        },
        "truncated": { "type": "boolean" }
      }
    },
    "dashboard": {
      "$id": "urn:literate-ai:schema:v1:html-observability-dashboard",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifacts", "dashboard_identity"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v1:html-observability-dashboard" },
        "dashboard_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "artifacts": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "project_id", "surface_id", "view_id", "artifact_identity"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "project_id": { "type": "string", "minLength": 1 },
              "surface_id": { "type": "string", "minLength": 1 },
              "view_id": { "type": "string", "minLength": 1 },
              "artifact_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "workflowRouting": {
      "$id": "urn:literate-ai:schema:v2:html-workflow-routing-catalog",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "project_id", "workflows", "routes"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:html-workflow-routing-catalog" },
        "project_id": { "type": "string", "minLength": 1 },
        "workflows": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content_identity", "workflow"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "content_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "workflow": { "type": "object" }
            }
          }
        },
        "routes": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content_identity", "routing"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "content_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "routing": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
