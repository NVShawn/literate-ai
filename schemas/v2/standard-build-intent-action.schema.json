{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:standard-build-intent-action-inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "execution_plan",
    "candidate",
    "contract",
    "native_sdk_inputs",
    "dependency_resolution",
    "index_result"
  ],
  "properties": {
    "schema": {
      "const": "urn:literate-ai:schema:v2:standard-build-intent-action-inputs"
    },
    "execution_plan": {
      "$ref": "urn:literate-ai:schema:v2:component-execution-plan"
    },
    "candidate": {
      "$ref": "urn:literate-ai:schema:v4:generated-source-candidate"
    },
    "contract": {
      "$ref": "urn:literate-ai:schema:v2:component-command-contract"
    },
    "native_sdk_inputs": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "dependency_resolution": {
      "enum": [
        "none",
        "npm",
        "python"
      ]
    },
    "index_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "component_revision",
        "source"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/disabled-source-index@1"
        },
        "component_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
