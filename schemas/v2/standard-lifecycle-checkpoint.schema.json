{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:standard-lifecycle-checkpoint-contracts",
  "oneOf": [
    {"$ref": "urn:literate-ai:schema:v2:standard-lifecycle-attempt-evidence"},
    {"$ref": "urn:literate-ai:schema:v2:standard-lifecycle-stage-evidence"},
    {"$ref": "urn:literate-ai:schema:v2:standard-lifecycle-checkpoint"}
  ],
  "$defs": {
    "attempt_evidence": {
      "$id": "urn:literate-ai:schema:v2:standard-lifecycle-attempt-evidence",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "execution_plan_identity",
        "component_revision",
        "generation_plan_identity",
        "generation_key_identity",
        "recipe_identity",
        "attempt",
        "predecessor_attempt_identity",
        "source_predecessor_identity"
      ],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:standard-lifecycle-attempt-evidence"},
        "execution_plan_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "component_revision": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "generation_plan_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "generation_key_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "recipe_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "attempt": {"type": "integer", "minimum": 1},
        "predecessor_attempt_identity": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v1:content-identity"}
          ]
        },
        "source_predecessor_identity": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v1:content-identity"}
          ]
        }
      }
    },
    "stage_evidence": {
      "$id": "urn:literate-ai:schema:v2:standard-lifecycle-stage-evidence",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "execution_plan_identity",
        "component_revision",
        "generation_plan_identity",
        "generation_key_identity",
        "recipe_identity",
        "source_generation",
        "stage",
        "subject_identity",
        "outcome",
        "failure_code"
      ],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:standard-lifecycle-stage-evidence"},
        "execution_plan_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "component_revision": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "generation_plan_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "generation_key_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "recipe_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "source_generation": {"$ref": "urn:literate-ai:schema:v3:source-generation-resume-candidate"},
        "stage": {
          "enum": [
            "source-generation",
            "build-intent",
            "source-index",
            "build-authorization",
            "build-plan",
            "build",
            "test",
            "execute",
            "accept",
            "source-cache-publication"
          ]
        },
        "subject_identity": {"$ref": "urn:literate-ai:schema:v1:content-identity"},
        "outcome": {"enum": ["passed", "failed"]},
        "failure_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "passed"}}},
          "then": {"properties": {"failure_code": {"type": "null"}}},
          "else": {"properties": {"failure_code": {"type": "string"}}}
        }
      ]
    },
    "checkpoint": {
      "$id": "urn:literate-ai:schema:v2:standard-lifecycle-checkpoint",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "attempt",
        "attempt_evidence",
        "attempt_sequence",
        "sequence",
        "predecessor_identity",
        "evidence",
        "source_files"
      ],
      "properties": {
        "schema": {"const": "urn:literate-ai:schema:v2:standard-lifecycle-checkpoint"},
        "attempt": {"type": "integer", "minimum": 1},
        "attempt_evidence": {"$ref": "urn:literate-ai:schema:v2:standard-lifecycle-attempt-evidence"},
        "attempt_sequence": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "predecessor_identity": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "urn:literate-ai:schema:v1:content-identity"}
          ]
        },
        "evidence": {"$ref": "urn:literate-ai:schema:v2:standard-lifecycle-stage-evidence"},
        "source_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {"$ref": "urn:literate-ai:schema:v2:cached-source-file"}
        }
      }
    }
  }
}
