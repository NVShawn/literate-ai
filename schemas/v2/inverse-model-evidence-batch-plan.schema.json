{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v1:inverse-model-evidence-batch-plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_snapshot_identity", "maximum_batch_bytes", "batches"],
  "properties": {
    "schema": { "const": "urn:literate-ai:schema:v1:inverse-model-evidence-batch-plan" },
    "source_snapshot_identity": { "$ref": "#/$defs/identity" },
    "maximum_batch_bytes": { "type": "integer", "minimum": 1 },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:literate-ai:schema:v1:inverse-model-evidence-batch" }
    }
  },
  "$defs": {
    "identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "batch": {
      "$id": "urn:literate-ai:schema:v1:inverse-model-evidence-batch",
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "language_ordinal", "language_batch_count", "evidence_ids", "source_paths", "admitted_byte_count"],
      "properties": {
        "language": { "enum": ["cpp", "javascript", "python", "rust"] },
        "language_ordinal": { "type": "integer", "minimum": 0 },
        "language_batch_count": { "type": "integer", "minimum": 1 },
        "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "source_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "admitted_byte_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
