{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v3:source-translation-evidence-contracts",
  "oneOf": [
    { "$ref": "urn:literate-ai:schema:v3:source-to-specification-intelligence" },
    { "$ref": "urn:literate-ai:schema:v3:source-to-specification-translation-run" }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "language": {
      "enum": ["cpp", "javascript", "python", "rust"]
    },
    "indexedSourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "identity"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "identity": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_snapshot_id",
        "content_digest",
        "path",
        "symbol"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_snapshot_id": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "content_digest": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" }
      }
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "language",
        "kind",
        "start_line",
        "end_line",
        "call_path",
        "content"
      ],
      "properties": {
        "reference": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/evidenceReference" },
        "language": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/language" },
        "kind": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "call_path": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "language", "text", "evidence_ids"],
      "properties": {
        "query_id": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "language": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/language" },
        "text": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "kind",
        "source_symbol",
        "source_path",
        "source_language",
        "target_symbol",
        "target_path",
        "target_language",
        "line",
        "column",
        "provenance",
        "resolution_method",
        "confidence_basis_points"
      ],
      "properties": {
        "relationship_id": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "kind": { "type": "string", "minLength": 1 },
        "source_symbol": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "source_language": { "type": "string", "minLength": 1 },
        "target_symbol": { "type": "string", "minLength": 1 },
        "target_path": { "type": "string", "minLength": 1 },
        "target_language": { "type": "string", "minLength": 1 },
        "line": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "column": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "provenance": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "resolution_method": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "confidence_basis_points": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 10000 },
            { "type": "null" }
          ]
        }
      }
    },
    "unresolvedRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved_id",
        "source_symbol",
        "source_path",
        "source_language",
        "reference_name",
        "reference_kind",
        "line",
        "column",
        "candidates"
      ],
      "properties": {
        "unresolved_id": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "source_symbol": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "source_language": { "type": "string", "minLength": 1 },
        "reference_name": { "type": "string", "minLength": 1 },
        "reference_kind": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 0 },
        "candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "intelligence": {
      "$id": "urn:literate-ai:schema:v3:source-to-specification-intelligence",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority_source_snapshot_id",
        "indexed_source_snapshot_id",
        "indexed_source_tree_id",
        "indexed_source_files",
        "source_content_identity",
        "source_material_identity",
        "intelligence_evidence_identity",
        "provider_id",
        "provider_version",
        "runtime_version",
        "executable_identity",
        "artifact_identity",
        "artifact_media_type",
        "capabilities",
        "provider_properties",
        "document_count",
        "symbol_count",
        "relationship_count",
        "unresolved_relationship_count",
        "warning_count",
        "languages",
        "evidence",
        "relationships",
        "unresolved_relationships",
        "queries"
      ],
      "properties": {
        "schema": {
          "const": "urn:literate-ai:schema:v3:source-to-specification-intelligence"
        },
        "authority_source_snapshot_id": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "indexed_source_snapshot_id": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "indexed_source_tree_id": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "indexed_source_files": {
          "type": "array",
          "items": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/indexedSourceFile" }
        },
        "source_content_identity": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "source_material_identity": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "intelligence_evidence_identity": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "provider_id": { "type": "string", "minLength": 1 },
        "provider_version": { "type": "string", "minLength": 1 },
        "runtime_version": { "type": "string", "minLength": 1 },
        "executable_identity": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "artifact_identity": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/identity" },
        "artifact_media_type": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "provider_properties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "document_count": { "type": "integer", "minimum": 0 },
        "symbol_count": { "type": "integer", "minimum": 0 },
        "relationship_count": { "type": "integer", "minimum": 0 },
        "unresolved_relationship_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/language" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/modelEvidence" }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/relationship" }
        },
        "unresolved_relationships": {
          "type": "array",
          "items": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/unresolvedRelationship" }
        },
        "queries": {
          "type": "array",
          "items": { "$ref": "urn:literate-ai:schema:v3:source-translation-evidence-contracts#/$defs/query" }
        }
      }
    },
    "translationRun": {
      "$id": "urn:literate-ai:schema:v3:source-to-specification-translation-run",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "mode", "intelligence", "journals"],
      "properties": {
        "schema": {
          "const": "urn:literate-ai:schema:v3:source-to-specification-translation-run"
        },
        "mode": {
          "enum": ["deterministic-static", "source-intelligence-coding-cli"]
        },
        "intelligence": {
          "oneOf": [
            { "$ref": "urn:literate-ai:schema:v3:source-to-specification-intelligence" },
            { "type": "null" }
          ]
        },
        "journals": {
          "type": "array",
          "items": {
            "$ref": "urn:literate-ai:schema:v1:source-to-specification-model-call-journal"
          }
        }
      }
    }
  }
}
