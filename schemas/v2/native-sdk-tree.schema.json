{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:native-sdk-tree@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "directories",
    "files",
    "aliases",
    "case_sensitive"
  ],
  "properties": {
    "schema": {
      "const": "urn:literate-ai:schema:v2:native-sdk-tree@1"
    },
    "directories": {
      "type": "array",
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:literate-ai:schema:v2:native-sdk-contracts#/$defs/file"
      }
    },
    "aliases": {
      "type": "array",
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "target",
          "kind"
        ],
        "properties": {
          "path": {
            "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "kind": {
            "enum": [
              "symlink",
              "hardlink"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "hardlink"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
                }
              }
            }
          }
        ]
      }
    },
    "case_sensitive": {
      "type": "boolean"
    }
  }
}
