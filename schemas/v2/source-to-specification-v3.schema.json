{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v3:source-to-specification-contracts",
  "oneOf": [
    { "$ref": "urn:literate-ai:schema:v3:source-to-specification-result" },
    { "$ref": "urn:literate-ai:schema:v3:component-graph-draft" }
  ],
  "$defs": {
    "capabilityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contract", "evidence_ids"],
      "properties": {
        "name": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/text" },
        "contract": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/text" },
        "evidence_ids": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/nonemptyStringArray" }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "path", "evidence_ids"],
      "properties": {
        "name": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/text" },
        "kind": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/text" },
        "path": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/text" },
        "evidence_ids": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/nonemptyStringArray" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate", "title", "kind", "profiles", "provided_capabilities",
        "capability_contracts", "entrypoints", "build_needs", "source_paths",
        "observation_ids", "evidence_ids"
      ],
      "properties": {
        "coordinate": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/text" },
        "title": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/text" },
        "kind": { "enum": ["library", "cli", "service"] },
        "profiles": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/nonemptyStringArray" },
        "provided_capabilities": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/nonemptyStringArray" },
        "library_imports": { "$ref": "urn:literate-ai:schema:v2:component-authoring-lock-contracts#/$defs/authoring/properties/library_imports" },
        "capability_contracts": {
          "type": "array", "minItems": 1, "items": { "$ref": "urn:literate-ai:schema:v3:source-to-specification-contracts#/$defs/capabilityContract" }
        },
        "entrypoints": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v3:source-to-specification-contracts#/$defs/entrypoint" } },
        "build_needs": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/nonemptyStringArray" },
        "source_paths": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/nonemptyStringArray" },
        "observation_ids": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/nonemptyStringArray" },
        "evidence_ids": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/nonemptyStringArray" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "library" } }, "required": ["kind"] },
          "then": { "properties": { "entrypoints": { "maxItems": 0 } } },
          "else": { "properties": { "entrypoints": { "minItems": 1 } } }
        }
      ]
    },
    "graph": {
      "$id": "urn:literate-ai:schema:v3:component-graph-draft",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source_snapshot_id", "root_coordinate", "nodes", "edges"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v3:component-graph-draft" },
        "source_snapshot_id": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/text" },
        "root_coordinate": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/text" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "urn:literate-ai:schema:v3:source-to-specification-contracts#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/componentGraphEdgeDraft" } }
      }
    },
    "result": {
      "$id": "urn:literate-ai:schema:v3:source-to-specification-result",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "request", "observations", "draft", "coverage", "uncertainty",
        "run", "component_definition_draft", "component_graph_draft"
      ],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v3:source-to-specification-result" },
        "request": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-request" },
        "observations": { "type": "array", "items": { "$ref": "urn:literate-ai:schema:v2:behavior-observation" } },
        "draft": { "$ref": "urn:literate-ai:schema:v2:specification-draft-set" },
        "coverage": { "$ref": "urn:literate-ai:schema:v2:source-specification-coverage-map" },
        "uncertainty": { "$ref": "urn:literate-ai:schema:v2:uncertainty-ledger" },
        "run": { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/run" },
        "component_definition_draft": {
          "oneOf": [
            { "$ref": "urn:literate-ai:schema:v2:source-to-specification-contracts#/$defs/componentDraft" },
            { "type": "null" }
          ]
        },
        "component_graph_draft": {
          "oneOf": [
            { "$ref": "urn:literate-ai:schema:v3:component-graph-draft" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
