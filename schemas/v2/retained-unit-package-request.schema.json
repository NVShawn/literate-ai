{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:retained-unit-package-request-contracts",
  "$ref": "urn:literate-ai:schema:v2:retained-unit-package-request-contracts#/$defs/request",
  "$defs": {
    "request": {
      "$id": "literate-ai/retained-unit-package-request@1",
      "description": "Authored opt-in only at an exact locked specification URI ending .package-unit.json. This intent cannot establish a live retained owner, native package admission or release authority. Prefixes and dependencies are canonically ordered; the contract parser enforces namespace and graph semantics.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "unit_name",
        "output_prefixes",
        "whole_payload",
        "license_path",
        "package",
        "version",
        "origin",
        "prefix",
        "dependencies"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/retained-unit-package-request@1"
        },
        "unit_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,126}$"
        },
        "output_prefixes": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Canonical project-relative POSIX path; the contract parser also enforces portable segments and refusal of traversal."
          }
        },
        "whole_payload": {
          "type": "boolean"
        },
        "license_path": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical project-relative POSIX path; the contract parser also enforces portable segments and refusal of traversal."
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:literate-ai:schema:v2:retained-unit-package-request-contracts#/$defs/dependency"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "whole_payload": {
              "const": true
            },
            "output_prefixes": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "whole_payload": {
              "const": false
            },
            "output_prefixes": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_name",
        "kind",
        "required_abi",
        "required_version"
      ],
      "properties": {
        "unit_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,126}$"
        },
        "kind": {
          "enum": [
            "build-input",
            "runtime",
            "tree-link"
          ]
        },
        "required_abi": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\r\\n\\u0000]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\r\\n\\u0000]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "build-input",
                  "runtime"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "required_abi": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^\\r\\n\\u0000]+$"
              },
              "required_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^\\r\\n\\u0000]+$"
              }
            }
          }
        }
      ]
    }
  }
}
