          },
          "input_identity": {
            "$ref": "urn:literate-ai:schema:v1:content-identity"
          },
          "tree_input_identity": {
            "$ref": "urn:literate-ai:schema:v1:content-identity"
          },
          "import_root": {
            "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
          },
          "snapshot": {
            "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
          },
          "binding": {
            "$ref": "urn:literate-ai:schema:v2:component-artifact-contracts#/$defs/path"
          }
        }
      }
