{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:retained-unit-package-definition-contracts",
  "$ref": "urn:literate-ai:schema:v2:retained-unit-package-definition-contracts#/$defs/definition",
  "$defs": {
    "definition": {
      "$id": "literate-ai/retained-unit-package-definition@1",
      "description": "Non-circular local retained provenance. Decoding does not establish a live owner, authoritative license, producer, runtime, LINK or PACKAGE admission.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authority_mode",
        "release_authorized",
        "unit_name",
        "component",
        "request_identity",
        "retained_plan_identity",
        "receipt_identity",
        "retained_source_identity",
        "payload_identity",
        "component_authoring_identity",
        "component_lock_identity",
        "recipe_identity",
        "target_identity",
        "source_bom_identity",
        "resolved_bom_identity",
        "license_identity",
        "provider_revision",
        "provider_parameters",
        "abi",
        "version",
        "provider"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/retained-unit-package-definition@1"
        },
        "authority_mode": {
          "const": "retained-project"
        },
        "release_authorized": {
          "const": false
        },
        "unit_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,126}$"
        },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "name"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
            }
          }
        },
        "request_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "retained_plan_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "receipt_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "retained_source_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "payload_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "component_authoring_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "component_lock_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "recipe_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resolved_bom_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "license_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_parameters": {
          "allOf": [
            {
              "$ref": "urn:literate-ai:schema:v1:blob-ref"
            },
            {
              "properties": {
                "media_type": {
                  "const": "application/json"
                },
                "size": {
                  "minimum": 1,
                  "maximum": 8388608
                }
              }
            }
          ]
        },
        "abi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "provider": {
          "const": "pkg"
        },
        "source_bom_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
