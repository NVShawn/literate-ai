{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:authored-qualification-reference",
  "title": "Published authored qualification reference; no importer or execution permission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origin",
    "plan_identity",
    "qualification_identity",
    "products_identity",
    "intent_identity",
    "stage_identity",
    "archive",
    "attempt"
  ],
  "properties": {
    "schema": {
      "const": "urn:literate-ai:schema:v2:authored-qualification-reference"
    },
    "origin": {
      "$ref": "urn:literate-ai:schema:v2:authored-qualification-origin"
    },
    "plan_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "qualification_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "products_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "intent_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "stage_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "size",
        "media_type"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "const": "application/zip"
        }
      }
    },
    "attempt": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
