{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:learning-contracts",
  "$defs": {
    "evidenceBinding": {
      "$id": "urn:literate-ai:schema:v2:learning-evidence-binding",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "kind", "identity"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:learning-evidence-binding" },
        "kind": { "enum": ["derivation", "build", "test", "acceptance", "rejection"] },
        "identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" }
      }
    },
    "signalEvidence": {
      "$id": "urn:literate-ai:schema:v2:learning-signal-evidence",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "signal", "evidence_identity"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:learning-signal-evidence" },
        "signal": { "enum": ["missing-behavior", "missing-public-interface", "target-variance", "reusable-conversion-technique", "stage-or-handoff", "routing-eligibility", "framework-defect", "authority-already-forbids"] },
        "evidence_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" }
      }
    },
    "observation": {
      "$id": "urn:literate-ai:schema:v2:learning-observation",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "component_revision", "project_lifecycle_result_identity", "observer_identity", "outcome", "evidence", "signal_evidence", "fact_codes"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:learning-observation" },
        "component_revision": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "project_lifecycle_result_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "observer_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "outcome": { "enum": ["accepted", "rejected"] },
        "evidence": { "type": "array", "minItems": 2, "maxItems": 16384, "uniqueItems": true, "items": { "$ref": "urn:literate-ai:schema:v2:learning-evidence-binding" } },
        "signal_evidence": { "type": "array", "maxItems": 16384, "uniqueItems": true, "items": { "$ref": "urn:literate-ai:schema:v2:learning-signal-evidence" } },
        "fact_codes": { "type": "array", "maxItems": 16384, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" } }
      }
    },
    "classification": {
      "$id": "urn:literate-ai:schema:v2:learning-classification",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "observation_identity", "classifier_identity", "disposition", "matched_signals"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:learning-classification" },
        "observation_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "classifier_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "disposition": { "enum": ["component-behavior", "component-interface", "flavor-variance", "skill-technique", "workflow-handoff", "routing-eligibility", "framework-defect", "candidate-specific-no-change"] },
        "matched_signals": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "urn:literate-ai:schema:v2:learning-contracts#/$defs/signalEvidence/properties/signal" } }
      }
    },
    "planInput": {
      "$id": "urn:literate-ai:schema:v2:learning-plan-input",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "observation", "component_authority_identities", "flavor_authority_identities", "skill_authority_identities", "workflow_authority_identities", "routing_authority_identities", "framework_authority_identities", "test_suite_identities", "rebuild_component_identities"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:learning-plan-input" },
        "observation": { "$ref": "urn:literate-ai:schema:v2:learning-observation" },
        "component_authority_identities": { "$ref": "urn:literate-ai:schema:v2:learning-contracts#/$defs/identities" },
        "flavor_authority_identities": { "$ref": "urn:literate-ai:schema:v2:learning-contracts#/$defs/identities" },
        "skill_authority_identities": { "$ref": "urn:literate-ai:schema:v2:learning-contracts#/$defs/identities" },
        "workflow_authority_identities": { "$ref": "urn:literate-ai:schema:v2:learning-contracts#/$defs/identities" },
        "routing_authority_identities": { "$ref": "urn:literate-ai:schema:v2:learning-contracts#/$defs/identities" },
        "framework_authority_identities": { "$ref": "urn:literate-ai:schema:v2:learning-contracts#/$defs/identities" },
        "test_suite_identities": { "$ref": "urn:literate-ai:schema:v2:learning-contracts#/$defs/identities" },
        "rebuild_component_identities": { "type": "array", "minItems": 1, "maxItems": 16384, "uniqueItems": true, "items": { "$ref": "urn:literate-ai:schema:v1:content-identity" } }
      }
    },
    "identities": {
      "type": "array", "maxItems": 16384, "uniqueItems": true,
      "items": { "$ref": "urn:literate-ai:schema:v1:content-identity" }
    },
    "proposal": {
      "$id": "urn:literate-ai:schema:v2:learning-proposal",
      "type": "object", "additionalProperties": false,
      "required": ["schema", "plan_input_identity", "observation_identity", "classification", "scope", "authority_identities", "affected_test_suite_identities", "rebuild_component_identities", "semantic_delta_codes"],
      "properties": {
        "schema": { "const": "urn:literate-ai:schema:v2:learning-proposal" },
        "plan_input_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "observation_identity": { "$ref": "urn:literate-ai:schema:v1:content-identity" },
        "classification": { "$ref": "urn:literate-ai:schema:v2:learning-classification" },
        "scope": { "enum": ["component", "flavor", "skill", "workflow", "routing-policy", "framework", "no-change"] },
        "authority_identities": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "$ref": "urn:literate-ai:schema:v1:content-identity" } },
        "affected_test_suite_identities": { "$ref": "urn:literate-ai:schema:v2:learning-contracts#/$defs/identities" },
        "rebuild_component_identities": { "type": "array", "minItems": 1, "maxItems": 16384, "uniqueItems": true, "items": { "$ref": "urn:literate-ai:schema:v1:content-identity" } },
        "semantic_delta_codes": { "type": "array", "maxItems": 16384, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$" } }
      }
    }
  },
  "oneOf": [
    { "$ref": "urn:literate-ai:schema:v2:learning-evidence-binding" },
    { "$ref": "urn:literate-ai:schema:v2:learning-signal-evidence" },
    { "$ref": "urn:literate-ai:schema:v2:learning-observation" },
    { "$ref": "urn:literate-ai:schema:v2:learning-classification" },
    { "$ref": "urn:literate-ai:schema:v2:learning-plan-input" },
    { "$ref": "urn:literate-ai:schema:v2:learning-proposal" }
  ]
}
